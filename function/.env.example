ADMIN_USERNAME="admin-username"
ADMIN_PASSWORD="admin-password"

JWT_SECRET="session-secret"

PORT="8000"

# Set to "production" in production (secure admin cookies). Development by default.
NODE_ENV="development"

MONGODB_URI="mongodb-connection-string"

CLOUDINARY_CLOUD_NAME="dbdtvd1qj"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

PAYSTACK_SECRET_KEY="sk_test_..."
APP_URL="http://localhost:3000"
# PAYSTACK_PUBLIC_KEY="pk_test_..."  # Optional: only needed for Paystack Inline checkout (future)

# Brevo transactional email (server-side only — never expose the API key to frontend code).
# BREVO_API_KEY comes from the Brevo dashboard. Leave blank to keep email disabled.
BREVO_API_KEY=
# BREVO_SENDER_EMAIL must be a sender identity verified in Brevo.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=A.F. Bookstore